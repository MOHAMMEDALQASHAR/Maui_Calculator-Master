<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Sayfa Arka Plan Renkleri -->
    <Color x:Key="PageBackgroundLight">#F3F3F3</Color>
    <Color x:Key="PageBackgroundDark">#202020</Color>

    <!-- Yazı / Etiket Renkleri -->
    <Color x:Key="TextPrimaryLight">#000000</Color>
    <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TextSecondaryLight">#5D5D5D</Color>
    <Color x:Key="TextSecondaryDark">#9E9E9E</Color>

    <!-- Buton Renkleri (Açık Tema) -->
    <Color x:Key="NumBtnBgLight">#FFFFFF</Color>
    <Color x:Key="NumBtnTextLight">#000000</Color>

    <Color x:Key="OpBtnBgLight">#F9F9F9</Color>
    <Color x:Key="OpBtnTextLight">#000000</Color>

    <Color x:Key="EqualBtnBgLight">#005FB8</Color>
    <Color x:Key="EqualBtnTextLight">#FFFFFF</Color>

    <!-- Buton Renkleri (Koyu Tema) -->
    <Color x:Key="NumBtnBgDark">#3B3B3B</Color>
    <Color x:Key="NumBtnTextDark">#FFFFFF</Color>

    <Color x:Key="OpBtnBgDark">#323232</Color>
    <Color x:Key="OpBtnTextDark">#FFFFFF</Color>

    <Color x:Key="EqualBtnBgDark">#4CC2FF</Color>
    <Color x:Key="EqualBtnTextDark">#000000</Color>

</ResourceDictionary>