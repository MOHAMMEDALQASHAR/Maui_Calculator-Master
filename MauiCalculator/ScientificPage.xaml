<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCalculator.ScientificPage"
             Title="Bilimsel">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, *, *, *, *, *, *" 
          ColumnDefinitions="*, *, *, *, *" 
          Padding="8"
          RowSpacing="3"
          ColumnSpacing="3">

        <!-- 0. Üst Geçmiş Satırı -->
        <Label x:Name="SciHistoryLabel" 
               Grid.Row="0" Grid.ColumnSpan="5" 
               Style="{StaticResource DisplayHistoryStyle}" 
               Text="" />

        <!-- 1. Ana Ekran / Sonuç Satırı -->
        <Label x:Name="SciDisplayLabel" 
               Grid.Row="1" Grid.ColumnSpan="5" 
               Style="{StaticResource DisplayResultStyle}" 
               Text="0" />

        <!-- 2. DEG / F-E ve Trigonometri Satırı -->
        <Grid Grid.Row="2" Grid.ColumnSpan="5" ColumnDefinitions="Auto, Auto, Auto, Auto, *">
            <Button x:Name="AngleModeButton" Grid.Column="0" Text="DEG" Clicked="OnAngleModeClicked" Style="{StaticResource ScientificButtonStyle}" />
            <Button Grid.Column="1" Text="F-E" Clicked="OnFunctionClicked" Style="{StaticResource ScientificButtonStyle}" />
            <Button Grid.Column="2" Text="Trigonometri ▾" Clicked="OnTrigMenuClicked" Style="{StaticResource ScientificButtonStyle}" />
            <Button Grid.Column="3" Text="İşlev ▾" Clicked="OnFunctionClicked" Style="{StaticResource ScientificButtonStyle}" />
        </Grid>

        <!-- 3. Hafıza Satırı: MC, MR, M+, M-, MS -->
        <Grid Grid.Row="3" Grid.ColumnSpan="5" ColumnDefinitions="*, *, *, *, *">
            <Button Grid.Column="0" Text="MC" Clicked="OnMemoryClicked" Style="{StaticResource ScientificButtonStyle}" />
            <Button Grid.Column="1" Text="MR" Clicked="OnMemoryClicked" Style="{StaticResource ScientificButtonStyle}" />
            <Button Grid.Column="2" Text="M+" Clicked="OnMemoryClicked" Style="{StaticResource ScientificButtonStyle}" />
            <Button Grid.Column="3" Text="M-" Clicked="OnMemoryClicked" Style="{StaticResource ScientificButtonStyle}" />
            <Button Grid.Column="4" Text="MS" Clicked="OnMemoryClicked" Style="{StaticResource ScientificButtonStyle}" />
        </Grid>

        <!-- 4. Satır: 2nd, π, e, C, ⌫ -->
        <Button Grid.Row="4" Grid.Column="0" Text="2ⁿᵈ" Clicked="OnFunctionClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="4" Grid.Column="1" Text="π" Clicked="OnConstantClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="4" Grid.Column="2" Text="e" Clicked="OnConstantClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="4" Grid.Column="3" Text="C" Clicked="OnClearClicked" Style="{StaticResource OperatorButtonStyle}" />
        <Button Grid.Row="4" Grid.Column="4" Text="⌫" Clicked="OnBackspaceClicked" Style="{StaticResource OperatorButtonStyle}" />

        <!-- 5. Satır: x², 1/x, |x|, exp, mod -->
        <Button Grid.Row="5" Grid.Column="0" Text="x²" Clicked="OnSpecialOpClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="5" Grid.Column="1" Text="1/x" Clicked="OnSpecialOpClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="5" Grid.Column="2" Text="|x|" Clicked="OnSpecialOpClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="5" Grid.Column="3" Text="exp" Clicked="OnFunctionClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="5" Grid.Column="4" Text="mod" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}" />

        <!-- 6. Satır: √x, (, ), n!, ÷ -->
        <Button Grid.Row="6" Grid.Column="0" Text="√x" Clicked="OnSpecialOpClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="6" Grid.Column="1" Text="(" Clicked="OnParenthesisClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="6" Grid.Column="2" Text=")" Clicked="OnParenthesisClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="6" Grid.Column="3" Text="n!" Clicked="OnSpecialOpClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="6" Grid.Column="4" Text="÷" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}" />

        <!-- 7. Satır: xʸ, 7, 8, 9, × -->
        <Button Grid.Row="7" Grid.Column="0" Text="xʸ" Clicked="OnOperatorClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="7" Grid.Column="1" Text="7" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="7" Grid.Column="2" Text="8" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="7" Grid.Column="3" Text="9" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="7" Grid.Column="4" Text="×" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}" />

        <!-- 8. Satır: 10ˣ, 4, 5, 6, - -->
        <Button Grid.Row="8" Grid.Column="0" Text="10ˣ" Clicked="OnSpecialOpClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="8" Grid.Column="1" Text="4" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="8" Grid.Column="2" Text="5" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="8" Grid.Column="3" Text="6" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="8" Grid.Column="4" Text="-" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}" />

        <!-- 9. Satır: log, 1, 2, 3, + -->
        <Button Grid.Row="9" Grid.Column="0" Text="log" Clicked="OnSpecialOpClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="9" Grid.Column="1" Text="1" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="9" Grid.Column="2" Text="2" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="9" Grid.Column="3" Text="3" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="9" Grid.Column="4" Text="+" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}" />

        <!-- 10. Satır: ln, +/-, 0, ,, = -->
        <Button Grid.Row="10" Grid.Column="0" Text="ln" Clicked="OnSpecialOpClicked" Style="{StaticResource ScientificButtonStyle}" />
        <Button Grid.Row="10" Grid.Column="1" Text="+/-" Clicked="OnNegateClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="10" Grid.Column="2" Text="0" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="10" Grid.Column="3" Text="," Clicked="OnDecimalClicked" Style="{StaticResource NumberButtonStyle}" />
        <Button Grid.Row="10" Grid.Column="4" Text="=" Clicked="OnEqualClicked" Style="{StaticResource EqualButtonStyle}" />

    </Grid>
</ContentPage>