<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiCalculator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiCalculator"
    Title="Hesap Makinesi"
    FlyoutBehavior="Flyout"
    Shell.BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#202020}"
    Shell.ForegroundColor="{AppThemeBinding Light=#1F1F1F, Dark=#FFFFFF}"
    Shell.TitleColor="{AppThemeBinding Light=#1F1F1F, Dark=#FFFFFF}">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="20,12">
                <Label Text="{Binding Title}"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light=#1F1F1F, Dark=#FFFFFF}"
                       VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Standart">
        <ShellContent
            Title="Standart"
            ContentTemplate="{DataTemplate local:StandardPage}"
            Route="StandardPage" />
    </FlyoutItem>

    <FlyoutItem Title="Bilimsel">
        <ShellContent
            Title="Bilimsel"
            ContentTemplate="{DataTemplate local:ScientificPage}"
            Route="ScientificPage" />
    </FlyoutItem>

    <FlyoutItem Title="Ayarlar">
        <ShellContent
            Title="Ayarlar"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </FlyoutItem>

</Shell>